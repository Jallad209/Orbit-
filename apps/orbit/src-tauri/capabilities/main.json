{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main Orbit window: full data and lifecycle surface, without capture-window-only controls. It may also emit events and request its own close: nothing in the app does either from JavaScript, but the WebDriver suite uses them to stand in for the shell (an activation) and the native X, and both stay inside this process.",
  "windows": ["main"],
  "permissions": [
    "core:path:allow-join",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-default-urls",
    "allow-db-open",
    "allow-db-close",
    "allow-db-execute",
    "allow-db-select",
    "allow-db-exec",
    "allow-db-begin",
    "allow-db-finish",
    "allow-data-dir-get",
    "allow-data-dir-set",
    "allow-data-dir-relocate",
    "allow-data-dir-default",
    "allow-data-dir-reveal",
    "allow-data-backups",
    "allow-data-backup-now",
    "allow-data-quarantine",
    "allow-data-restore",
    "allow-data-restore-backup",
    "allow-file-read-text",
    "allow-file-write-text",
    "allow-capture-show",
    "allow-diagnostics-last-run",
    "allow-diagnostics-integrity",
    "allow-diagnostics-log",
    "allow-diagnostics-export",
    "allow-prefs-get",
    "allow-prefs-set",
    "allow-prefs-migrate-legacy",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-resident-status",
    "allow-resident-ready",
    "allow-resident-show-main",
    "allow-resident-hide-main",
    "allow-resident-quit",
    "allow-resident-quit-ack",
    "allow-resident-activation-pending",
    "allow-resident-activation-subscribed",
    "allow-resident-activation-unsubscribed",
    "allow-scheduler-wake"
  ]
}
