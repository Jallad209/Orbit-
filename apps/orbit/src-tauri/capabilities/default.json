{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main and capture windows may call. Data access goes through Orbit's own commands, so no file-system scopes are granted to the WebView.",
  "windows": ["main", "capture"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:event:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    "autostart:default"
  ]
}
